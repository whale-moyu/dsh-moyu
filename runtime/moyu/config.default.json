{
  "version": 1,
  "budget": {
    "absoluteYuan": 35,
    "remindPercent": 80
  },
  "wake": {
    "maxCount": 0,
    "intervalMinutes": 30
  },
  "window": {
    "mode": "duration",
    "durationMinutes": 720,
    "timeRange": "21:00-23:30"
  },
  "play": {
    "remindMinutes": 40,
    "limitMinutes": 60
  },
  "paths": {
    "writable": [
      "freetime/"
    ],
    "readonly": "all",
    "protected": [
      "E:\\dsh\\DeepSeek Harness.exe",
      "E:\\dsh\\resources\\app.asar",
      "E:\\dsh\\Uninstall DeepSeek Harness.exe",
      "E:\\dsh\\resources\\app-update.yml",
      "C:\\Users\\Administrator\\.dsh\\tools\\desktop.ps1",
      "C:\\Users\\Administrator\\.dsh\\moyu\\tools\\desktop.ps1",
      "C:\\Users\\Administrator\\.dsh\\moyu\\tools\\guard.json"
    ],
    "readDenied": [
      "C:\\Users\\Administrator\\.dsh\\.credentials.yaml",
      "C:\\Users\\Administrator\\.dsh\\qq-console.json",
      "C:\\Users\\Administrator\\.dsh\\surfcore\\config.json",
      "D:\\surfcore\\config.json",
      "E:\\SnowLuma\\SnowLuma-v2.2.1-win-x64\\config",
      "C:\\Users\\Administrator\\AppData\\Roaming\\Tencent",
      "C:\\Users\\Administrator\\.dsh\\storages"
    ]
  },
  "permissions": {
    "runCommands": "games",
    "networkReadonly": true,
    "social": "owner",
    "desktopControl": true
  },
  "rejection": {
    "mode": "off"
  },
  "watch": {
    "outer": true,
    "outerOnCrashOnly": false
  },
  "float": {
    "enabled": true
  },
  "scopes": {
    "playground": {
      "label": "游乐场",
      "write": [
        "~\\AkPlay"
      ],
      "run": [
        "node",
        "python",
        "py"
      ],
      "net": false,
      "timeoutMs": 60000,
      "user": "moyu"
    },
    "games": {
      "label": "玩游戏",
      "write": [
        "~\\AkPlay"
      ],
      "run": [],
      "runPaths": [
        "E:/Steam/steamapps/common/Minimalist Tower Defense/Minimalist Tower Defense.exe",
        "E:/Steam/steamapps/common/SlayTheSpire/SlayTheSpire.exe"
      ],
      "net": false,
      "timeoutMs": 3600000,
      "user": "moyu"
    },
    "media": {
      "label": "剪音视频",
      "write": [
        "~\\AkPlay"
      ],
      "run": [],
      "runPaths": [
        "C:\\Users\\Administrator\\AppData\\Local/Microsoft/WinGet/Links/ffmpeg.exe",
        "C:\\Users\\Administrator\\AppData\\Local/Microsoft/WinGet/Links/ffprobe.exe"
      ],
      "net": false,
      "timeoutMs": 600000,
      "user": "moyu"
    }
  },
  "web": {
    "blockRawUpload": true,
    "blockLocalFiles": true
  },
  "strict": {
    "level": 0,
    "hands": false,
    "outbound": false,
    "passSalt": "",
    "passHash": "",
    "until": ""
  },
  "notebook": "",
  "call": {
    "enabled": true
  }
